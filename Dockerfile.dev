# Single image for local development AND CI — so behavior stays identical.
# Developers don't need Rust on the host: everything runs via docker compose.
FROM rust:latest

# System tools:
#  - openssh-client — SSH to RouterOS runs via subprocess (system ssh), Stage 2.
#  - gcc-mingw-w64 / gcc-aarch64 — linkers for cross-compilation (release, Stage 9).
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        gcc-mingw-w64-x86-64 \
        gcc-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/*

# cargo-watch — interactive dev loop (the `dev` service).
RUN cargo install cargo-watch --locked

WORKDIR /app

# Pin the toolchain BEFORE running rustup, so components and cross targets are
# added to the exact toolchain that rust-toolchain.toml selects at runtime.
# Otherwise they land on the image's default toolchain and the pinned one is
# missing them (e.g. std for aarch64/windows → "can't find crate for std").
# This also pre-installs the pinned toolchain, avoiding a re-sync on every run.
COPY rust-toolchain.toml .
RUN rustup show \
    && rustup target add \
        x86_64-unknown-linux-gnu \
        aarch64-unknown-linux-gnu \
        x86_64-pc-windows-gnu

# macOS targets are not added here: cross-building for Apple from a Linux image
# needs osxcross+SDK; in release.yml macOS is built on a native runner.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
